# ========================================
# CULTIVAR 31: Piracicaba Precoce (Brócolis)
# ========================================

conto:cv_Piracicaba_Precoce a conto:Cultivar ;
    skos:prefLabel "Piracicaba Precoce"@pt-br ;
    rdfs:comment "Variedade ramoso, de coloração verde azulado, apresenta excelente adaptação a climas amenos e quentes. Devido aos talos firmes, essa variedade é mais indicada para ser cozida no vapor, proporcionando uma experiência mais agradável em saladas, refogados, quiches, empadas, entre outros pratos. Cultivar de plantas vigorosas demonstra boa resistência a temperaturas elevadas. Produz inflorescências de cor creme, com firmeza, medindo entre 15 a 20 cm de diâmetro e pesando de 0,7 a 1,2 kg. Seu ciclo de crescimento varia entre 80 e 90 dias a partir da semeadura."@pt-br ;
    conto:hasSpecies conto:e_Couve ;
    conto:providesProduct conto:prod_Cabeca_Piracicaba, conto:prod_Folha_Piracicaba ;
    conto:hasTrait conto:flower_color_VerdeEscuro, conto:diameter_Piracicaba,
                    conto:height_Piracicaba ;
    conto:hasPreference conto:pref_Temp_Couve, conto:pref_pH_Alface, conto:LP_FullSun, conto:WP_High, conto:SDP_WellDrainedSoil ;
    conto:hasManagement conto:mgmt_Planting_Piracicaba .

