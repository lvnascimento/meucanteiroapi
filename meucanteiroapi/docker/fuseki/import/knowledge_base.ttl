    conto:rowSpacing conto:q_RowSpacing_20cm ;
    conto:plantSpacing conto:q_PlantSpacing_5cm ;
    conto:hasPlantingMethod conto:method_DirectSeeding_BRS_Paranoa ;
    conto:hasPlantingSeason conto:season_AnoTodo_R1,
                           conto:season_JanMar_OutDez_R2,
                           conto:season_JanFev_OutDez_R3 .

