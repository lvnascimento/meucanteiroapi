# ========================================
# CULTIVAR 1: BRS Paranoá
# ========================================

conto:cv_BRS_Paranoa a conto:Cultivar ;
    skos:prefLabel "BRS Paranoá"@pt-br ;
    rdfs:comment "A cenoura BRS Paranoá é primeira cultivar nacional desenvolvida e validada exclusivamente para sistemas orgânicos de produção. Além disso, apresenta alta resistência ao complexo da queima-das-folhas, causado pelos fungos Alternaria dauci, Cercospora carotae e pela bactéria Xanthomonas hortorum pv. carotae, dispensando completamente qualquer tipo de controle para essa doença. As raízes ainda se destacam pela ótima qualidade em termos de doçura e ótima aparência."@pt-br ;
    conto:hasSpecies conto:e_Cenoura ;
    conto:providesProduct conto:prod_Raiz_BRS_Paranoa, conto:prod_Flor_BRS_Paranoa ;
    conto:hasTrait conto:root_shape_RetaLisa, conto:root_color_LaranjaIntenso, 
                    conto:root_thickness_BRS_Paranoa, conto:root_length_BRS_Paranoa,
                    conto:leaf_color_Verde, conto:flower_color_Branco ;
    conto:hasPreference conto:pref_Temp_BRS_Paranoa, conto:pref_pH_Cenouras, conto:SDP_WellDrainedSoil, conto:WP_Moderate, conto:LP_FullSun ;
    conto:hasManagement conto:mgmt_Planting_BRS_Paranoa .

# Produtos
conto:prod_Raiz_BRS_Paranoa a conto:p_Cenoura ;
	conto:hasHarvest conto:harvest_BRS_Paranoa .

conto:harvest_BRS_Paranoa a conto:AnnualCropHarvest ;
    conto:timeToHarvest_Summer conto:q_Tempo_90d .
	
conto:prod_Flor_BRS_Paranoa a conto:p_FlorDeCenoura .

# Preferências
