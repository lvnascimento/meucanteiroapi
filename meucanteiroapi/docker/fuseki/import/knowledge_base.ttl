@prefix agro: <http://purl.obolibrary.org/obo/AGRO_> .
@prefix ro: <http://purl.obolibrary.org/obo/RO_> .
@prefix envo: <http://purl.obolibrary.org/obo/ENVO_> .


# ========================================
# Classes Gerais
# ========================================

conto:RegionalName a rdfs:Class ;
	rdfs:label "Nome Regional"@pt-br ;
	dc:description "Nome de um produto, espécie ou cultivar usado em uma determinada região."@pt-br .

conto:p_ProdutoPrincipal a rdfs:Class;
	rdfs:label "Produto Principal"@pt-br;
	dc:description "Produto mais conhecido popularmente e consumido da planta."@pt-br;
	rdfs:subClassOf conto:Product .
	
conto:p_ProdutoSecundario a rdfs:Class;
	rdfs:label "Produto Secundário"@pt-br;
	dc:description "Produto alimentício não-convencional da planta, obtidos a partir de partes alternativas da planta."@pt-br;
	rdfs:subClassOf conto:Product .

# ========================================
# Propriedades Gerais
# ========================================

conto:hasRegionalName a owl:ObjectProperty ;
	rdfs:label "has regional name"@en, "tem nome regional"@pt-br ;
	dc:description 
		"Nome regional associado a uma instância."@pt-br,
		"Regional name related to an instance."@en ;
	rdfs:range conto:RegionalName .

# ========================================
# Classes para Produtos
# ========================================

conto:p_AboboraDePescoco a rdfs:Class ;
	rdfs:label "Abóbora de Pescoço"@pt-br;
