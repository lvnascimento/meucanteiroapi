# ========================================
# CULTIVAR 4: Itapuã 202
# ========================================

conto:cv_Itapua_202 a conto:Cultivar ;
    skos:prefLabel "Itapuã 202"@pt-br ;
    rdfs:comment "Variedade de ciclo curto e de alta produtividade. Raízes muito uniformes, de pele lisa e com baixa incidência de anéis brancos. Excelente desenvolvimento foliar, com folhas de coloração verde intenso. Ótima opção para a produção de baby leaf. Resistente a Cercóspora."@pt-br ;
    conto:hasSpecies conto:e_Beterraba ;
    conto:providesProduct conto:prod_Raiz_Itapua_202, conto:prod_Folha_Itapua_202;
    conto:hasTrait conto:root_shape_RedondaAchatada, conto:root_color_RoxoEscuro,
                    conto:root_thickness_Itapua_202, conto:root_length_Itapua_202,
                    conto:leaf_color_Verde, conto:flower_color_Roxo ;
    conto:hasPreference conto:pref_Temp_Itapua_202, conto:pref_pH_Itapua_202, conto:LP_FullSun, conto:WP_High, conto:SDP_WellDrainedSoil ;
    conto:hasManagement conto:mgmt_Planting_Itapua_202 ;
	conto:hasManagement conto:m_Geral_Beterraba ;
	conto:hasManagement conto:m_Controle_Pragas ;
	conto:hasManagement conto:m_Desbaste .

# Produtos
conto:prod_Raiz_Itapua_202 a conto:p_Beterraba ;
	conto:hasHarvest conto:harvest_Itapua_202 .

conto:harvest_Itapua_202 a conto:AnnualCropHarvest ;
	dc:description "Puxe cuidadosamente pelos talos das folhas ou solte a terra ao redor com a mão ou pá."@pt-br ;
    conto:timeToHarvest_Summer conto:q_Tempo_60d ;
    conto:timeToHarvest_Winter conto:q_Tempo_75d ;
	conto:hasCondition conto:harvest_Itapua_202_Condition .
	
conto:harvest_Itapua_202_Condition a conto:Condition ;
	rdfs:label "Quando as raízes atingem o tamanho ideal e a parte superior está bem formada."@pt-br .

conto:prod_Folha_Itapua_202 a conto:p_FolhaBeterraba .

# Preferências
conto:pref_Temp_Itapua_202 a conto:TemperaturePreference ;
    qudt:hasQuantity conto:q_Temp_15a20C .

conto:pref_pH_Itapua_202 a conto:SoilpHPreference ;
    qudt:hasQuantity conto:q_pH_6a7 .

# Manejo geral para todos os cultivares de beterraba ao longo de todo o ciclo produtivo.
conto:m_Geral_Beterraba a conto:Management ;

	# Ações individuais desta prática de manejo
	conto:hasManagementPractice conto:mng_pract_Capina ; # Ação de capina manual para remover plantas daninhas.
	conto:hasManagementPractice conto:mng_pract_Irrigacao_Leve_Manha_Todo_Ciclo ; # Prática de irrigação.

	# Etapa de desenvolvimento da planta a que se aplica esta prática.
	conto:hasApplicationWindow conto:m_Geral_Beterraba_Window .
	
conto:m_Geral_Beterraba_Window a conto:ApplicationWindow ;
	conto:appliesThroughoutCycle true .
	
# Controle de plantas daninhas com capina manual para cultivos em geral.
conto:mng_pract_Capina a agro:00020006 ;
    rdfs:label "Capina Manual"@pt-br ;
	dc:description "Capina manual de plantas daninhas, à medida que essas ocorrerem na cultura."@pt-br ;
	rdfs:comment "Dados de pesquisa revelaram que o período crítico de competição entre as plantas daninhas e a planta de beterraba ocorre entre a 2ª e 6ª semanas após a emergência das plantas. Essa competição pode causar perdas de 79% a 96% na produção de raízes, sem mencionar a perda de qualidade do produto em razão da redução do calibre das raízes produzidas."@pt-br .

# Irrigação leve durante a manhã durante todo o ciclo para cultivos em geral.
conto:mng_pract_Irrigacao_Leve_Manha_Todo_Ciclo a agro:00000006 ;
	rdfs:label "Irrigação Leve e Frequente pela Manhã Durante Todo o Ciclo"@pt-br ;
	dc:description "Deve-se realizar irrigações leves e frequentes durante todo o ciclo, sempre no período da manhã, para que a cultura não permaneça molhada durante a noite, que favorecerá o aparecimento de doenças."@pt-br .

conto:m_Controle_Pragas a conto:Management ;
	conto:hasManagementPractice conto:Controle_De_Pragas ;
	conto:hasCondition conto:cond_Se_Houver_Largartas_Pulgoes ;
	conto:hasApplicationWindow conto:m_Geral_Beterraba_Window .
	
conto:Controle_De_Pragas a agro:00000023 ;
	rdfs:label "Controle de Pragas"@pt-br ;
	dc:description "Use calda de neem ou sabão neutro."@pt-br .
	
conto:cond_Se_Houver_Largartas_Pulgoes a conto:Condition ;
	rdfs:label "Se houver lagartas e pulgões" .
	
conto:m_Desbaste a conto:Management ;
	conto:hasManagementPractice conto:Desbaste;
	conto:hasApplicationWindow conto:window_15d_Emergencia .
	
conto:window_15d_Emergencia a conto:ApplicationWindow ;
	conto:relativeToStage conto:RS_Emergence ;
	conto:startOffset conto:t_Duration_15d .

conto:t_Duration_15d a time:Duration ;
	time:numericDuration 15 ;
	time:unitType time:unitDay .
	
conto:Desbaste a agro:00000027 ;
	rdfs:label "Desbaste"@pt-br ;
	dc:description "Retire as plantas mais fracas, mantendo o espaçamento recomendado."@pt-br .

