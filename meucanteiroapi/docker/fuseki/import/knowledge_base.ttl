# ========================================

conto:cv_SCS375_Kaicara a conto:Cultivar ;
    skos:prefLabel "SCS375 Kaicara"@pt-br ;
    rdfs:comment "Planta de tipo indeterminado e frutos de tamanho médio, coloração vermelho e formato caqui. O fruto também apresenta excelente sabor e produtividade. Planta de crescimento indeterminado com média de produtividade de 67 t/há. Folhas curtas, horizontais e de largura média. Cultivar que apresenta frutos de excelente sabor, além de boa tolerância a doenças foliares, o que a torna adequada aos diversos sistemas de cultivo, principalmente o orgânico."@pt-br ;
    conto:hasSpecies conto:e_Tomate ;
    conto:providesProduct conto:prod_Fruto_Kaicara ;
